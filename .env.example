# Application environment (development | production)
ENV=development

# --- Database Connection (Supabase or local PostgreSQL) ---
# For Supabase, paste your project connection string from Project Settings > Database > URI:
# DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# For local Docker / Postgres:
DB_URL="postgresql+asyncpg://ragops:ragops@localhost:5432/eval_results"

# --- Docker Compose overrides (used by docker-compose.yml) ---
DB_USER=ragops
DB_PASSWORD=ragops
DB_NAME=eval_results

# Port the backend API is exposed on the host machine
BACKEND_PORT=8000

# LLM Judge (Stage 5 evaluation)
GEMINI_API_KEY=
