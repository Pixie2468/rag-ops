# Application environment (development | production)
ENV=development

# --- Database (direct connection, used when running locally without Docker) ---
DB_URL="postgresql+asyncpg://ragops:ragops@localhost:5432/eval_results"

# --- Docker Compose overrides (used by docker-compose.yml) ---
DB_USER=ragops
DB_PASSWORD=ragops
DB_NAME=eval_results

# Port the backend API is exposed on the host machine
BACKEND_PORT=8000