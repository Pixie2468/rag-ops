# ==============================================================================
# RAGOps Environment Configuration
# ==============================================================================

# Application environment (development | production)
ENV=development

# ------------------------------------------------------------------------------
# 1. Database Connection (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# SUPABASE CONNECTION (Recommended):
# Copy your connection URI from: Supabase Dashboard > Project Settings > Database > Connection String > URI
# RAGOps automatically formats it for asyncpg and enables SSL.
# Example:
# DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# LOCAL DOCKER / POSTGRES (Fallback):
DB_URL="postgresql+asyncpg://ragops:ragops@localhost:5432/eval_results"

# Docker Compose database credentials (used by docker-compose.yml)
DB_USER=ragops
DB_PASSWORD=ragops
DB_NAME=eval_results

# ------------------------------------------------------------------------------
# 2. LLM-as-a-Judge (Google Gemini)
# ------------------------------------------------------------------------------
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Default Gemini model for Stage 5 evaluation (defaults to gemini-3.5-flash)
# Automatic fallback pool: gemini-3.8-flash -> gemini-3.5-flash -> gemini-3.5-flash-lite -> gemini-flash-lite-latest
GEMINI_JUDGE_MODEL="gemini-3.5-flash"

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
# Port for the FastAPI backend API server
BACKEND_PORT=8000
HOST="0.0.0.0"

# Backend URL used by frontend proxy
BACKEND_URL="http://localhost:8000"
